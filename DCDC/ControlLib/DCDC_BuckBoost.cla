}

#pragma CODE_SECTION(Cla1Task8,"Cla1Prog");
__interrupt void Cla1Task8(void)
{
    float32 fRatedRecipTmp;

//    #if CLA_DEBUG
//    __mdebugstop();
//    #endif

    if(0xFF != uwClaFPUMode)//CLA浮点计算采用就近舍入向偶舍入模式
    {
        __asm (" MSETFLG RNDF32=1");
        uwClaFPUMode = 0xFF;
    }

    __meallow();
    EPwm1Regs.AQCSFRC.bit.CSFA = 1;
    EPwm1Regs.AQCSFRC.bit.CSFB = 1;
    EPwm1Regs.TZFRC.bit.OST = 1;//软件触发TZ
    EPwm1Regs.CMPA.half.CMPA = 0;
    EPwm1Regs.CMPB = 0;
    __medis();

    fRatedRecipTmp = DC_CURR_RECIP;
    g_strAdcPool.fIbuckboostAdc_K = fAdcHwRatio[eIbuckboost]*0.00001*fRatedRecipTmp;//比例系数
    g_strAdcPool.fIbatAdc_K = fAdcHwRatio[eIbat]*0.00001*fRatedRecipTmp;

    g_strAdcPool.fIbuckboostAdc_B = g_strClaIn_AdcRawData.udIbuckboostAdcVal;//零偏校准值
    g_strAdcPool.fIbatAdc_B = g_strClaIn_AdcRawData.udIbatAdcVal;


    fRatedRecipTmp = DC_VOLT_RECIP;
    g_strAdcPool.fVbusAdc_K = fAdcHwRatio[eVbus]*0.00001*fRatedRecipTmp;
    g_strAdcPool.fVbatAdc_K = fAdcHwRatio[eVbat]*0.00001*fRatedRecipTmp;
    g_strAdcPool.fVbatRelayAdc_K = fAdcHwRatio[eVbat_Relay]*0.00001*fRatedRecipTmp;
    g_strAdcPool.fVportAdc_K = fAdcHwRatio[eVport]*0.00001*fRatedRecipTmp;

    g_strAdcPool.fVbatRealFilter = 0;
    g_strAdcPool.fVbusRealFilter = 0;
    g_strAdcPool.fIbatRealFilter = 0;

    g_strBuckBoostCtrlPara.fBusRef = 200.0 *DC_VOLT_RECIP;
    g_strBuckBoostCtrlPara.fChargeBatVoltRef = 200.0 *DC_VOLT_RECIP;
    g_strBuckBoostCtrlPara.fDisChargeBatVoltRef = 200.0 *DC_VOLT_RECIP;


    g_strBusVolt_BuckBoost.fKp = 0.02;    // 母线电压
    g_strBusVolt_BuckBoost.fKi = 0.002;
    g_strBusVolt_BuckBoost.fPIMax = 1.0;
    g_strBusVolt_BuckBoost.fPIMin = -0.1; // 0
    g_strBusVolt_BuckBoost.fErrOld = 0;
    g_strBusVolt_BuckBoost.fLoopOutOld = 0;

    g_strDisChargeBatVolt_BuckBoost.fKp = 0.05;  // 放电电压
    g_strDisChargeBatVolt_BuckBoost.fKi = 0.005;
    g_strDisChargeBatVolt_BuckBoost.fPIMax = 1;
    g_strDisChargeBatVolt_BuckBoost.fPIMin = -0.1; // 0
    g_strDisChargeBatVolt_BuckBoost.fErrOld = 0;
    g_strDisChargeBatVolt_BuckBoost.fLoopOutOld = 0;

//    g_strChargeBatVolt_BuckBoost.fKp = 0.2;     // 充电电压
//    g_strChargeBatVolt_BuckBoost.fKi = 0.02;
    g_strChargeBatVolt_BuckBoost.fKp = 0.1;     // 充电电压
//    g_strChargeBatVolt_BuckBoost.fKi = 0.01;
     g_strChargeBatVolt_BuckBoost.fKi = 0.8;     // 增大这个积分，以免恒压时电压冲得太高，也稳不下来一直跳的问题


    g_strChargeBatVolt_BuckBoost.fPIMax = 1.0;
    g_strChargeBatVolt_BuckBoost.fPIMin = -0.2; // 0
    g_strChargeBatVolt_BuckBoost.fErrOld = 0;
    g_strChargeBatVolt_BuckBoost.fLoopOutOld = 0;

//    g_strBatCurr_BuckBoost.fKp = 0.02;            // 电池电流
    //   g_strBatCurr_BuckBoost.fKp = 0.005;            // 电池电流
    //   g_strBatCurr_BuckBoost.fKi = 0.001;
    g_strBatCurr_BuckBoost.fKp = 0.005;            // 电池电流
    g_strBatCurr_BuckBoost.fKi = 0.01;  // 增加KI，放电过冲才小
    g_strBatCurr_BuckBoost.fPIMax = 1.0;
    g_strBatCurr_BuckBoost.fPIMin = -0.1; // 0
    g_strBatCurr_BuckBoost.fErrOld = 0;
    g_strBatCurr_BuckBoost.fLoopOutOld = 0;

}

#endif  //TASK_CLA

